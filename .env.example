# Copy to .env and adjust. Never commit .env.

# Port and public URL of the collector (what the <script> tag points to).
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000

# "development" (default) or "production". In production the read APIs
# (/api/pages, /api/heatmap, /api/stats, screenshots, capture) require DASHBOARD_TOKEN
# and /api/seed + the demo page are disabled.
NODE_ENV=development
DASHBOARD_TOKEN=

# Comma-separated origins allowed to POST /api/collect, e.g.
# https://www.yourstore.com,https://yourstore.myshopify.com   ("*" = any; dev default)
ALLOWED_ORIGINS=*

# Max /api/collect requests per IP per minute.
COLLECT_RATE_LIMIT=120

# Where SQLite + screenshots live (outside the build).
DATA_DIR=./data

# Labels that count as an add-to-cart click (case-insensitive substrings).
ATC_LABELS=add to cart,buy now,add to bag,buy it now

# Extra CSS selectors to hide before screenshots (popups, chat widgets...).
CAPTURE_HIDE_SELECTORS=
# Devices to capture. tablet is also captured automatically when a page has tablet traffic.
CAPTURE_DEVICES=mobile,desktop
# npm run watch re-checks every page this often.
CAPTURE_INTERVAL_HOURS=6
